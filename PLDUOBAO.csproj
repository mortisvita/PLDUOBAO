<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <Platforms>x64</Platforms>
	  <PlatformTarget>x64</PlatformTarget>
	  <AssemblyName>PLDUOBAO</AssemblyName>
	  <RootNamespace>PLDUOBAO</RootNamespace>
	  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	  <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
	

	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<PublishAot>true</PublishAot>
		<TrimMode>full</TrimMode>
		<RunAOTCompilation>true</RunAOTCompilation>
		<OptimizationPreference>Size</OptimizationPreference>
		<StackTraceSupport>false</StackTraceSupport>
		<IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<NaotGuardPreset>maximum</NaotGuardPreset>
		<NaotGuardAuditProfile>none</NaotGuardAuditProfile>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">

	</ItemGroup>
	

	<ItemGroup>
	  <AvaloniaXaml Remove="Memory\**" />
	  <AvaloniaXaml Remove="scripts\**" />
	  <Compile Remove="Memory\**" />
	  <Compile Remove="scripts\**" />
	  <EmbeddedResource Remove="Memory\**" />
	  <EmbeddedResource Remove="scripts\**" />
	  <None Remove="Memory\**" />
	  <None Remove="scripts\**" />
	  <Compile Remove="Network\MPay\MPay.cs" />
	  <AvaloniaXaml Remove="auth-server\**" />
	  <Compile Remove="auth-server\**" />
	  <EmbeddedResource Remove="auth-server\**" />
	  <None Remove="auth-server\**" />
	</ItemGroup>
	

	<ItemGroup>
	  <None Remove="Native\PLDUOBAO.DeviceSpoof64.exe" />
	  <None Remove="Native\PyCodeExecuter64.dll" />
	</ItemGroup>

	<ItemGroup Label="Linker" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<DirectPInvoke Include="libHarfBuzzSharp" />
		<DirectPInvoke Include="libSkiaSharp" />
		<DirectPInvoke Include="av_libglesv2" />
		<LinkerArg Include="d3d9.lib;dxguid.lib" />
		<LinkerArg Include="dxgi.lib" />
		<LinkerArg Include="Gdi32.lib;User32.lib" />
		<LinkerArg Include="synchronization.lib" />
		<LinkerArg Include="fontsub.lib;Ole32.lib;USP10.lib" />
		<LinkerArg Include="d3d12.lib;d3dcompiler.lib" />
	</ItemGroup>
	
	<ItemGroup>
	<PackageReference Include="Avalonia" Version="11.3.11" />
	<PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
	<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.3.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
	<PackageReference Include="2ndLAB.ANGLE.Static" Version="7151.0.0-10.0.26100.0-1.79e529b" />
	<PackageReference Include="2ndLAB.SkiaSharp.Static" Version="2.88.9-10.0.26100.0-1.1c7d845" />
	<PackageReference Include="VC-LTL" Version="5.3.1" />
	<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
	<PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
  </ItemGroup>


	<ItemGroup>
	  <Content Include="Native\PLDUOBAO.DeviceSpoof64.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Native\PyCodeExecuter64.dll">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <AvaloniaResource Include="Assets\**" />
	  <AvaloniaResource Remove="auth-server\**" />
	</ItemGroup>


	<ItemGroup>
	  <Folder Include="Network\Netease\NetworkSDK\PCCommon\Requests\" />
	</ItemGroup>


	<ItemGroup>
	  <AdditionalFiles Remove="auth-server\**" />
	</ItemGroup>

</Project>
