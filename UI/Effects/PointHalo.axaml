<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             PointerEntered="Control_PointerEntered"
             PointerExited="Control_PointerExited"
             x:Class="PLDUOBAO.UI.Effects.PointHalo">
    <Border ClipToBounds="True" CornerRadius="3">
        <Canvas x:Name="MainCanvas" Background="Transparent" PointerMoved="Canvas_PointerMoved"
                ClipToBounds="True">
            <Ellipse x:Name="MovingRing"
                     Width="160"
                     Height="160"
                     Opacity="0">
                <Ellipse.Styles>
                    <Style Selector="Ellipse#MovingRing">
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                            </Transitions>
                        </Setter>
                    </Style>
                </Ellipse.Styles>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="80,80" GradientOrigin="80,80">
                        <GradientStop Color="Gray" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="0.8"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
    </Border>
</UserControl>
