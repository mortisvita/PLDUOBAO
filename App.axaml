<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="PLDUOBAO.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True"/>
        <StyleInclude Source="avares://PLDUOBAO/Styles/GlobalStyles.axaml"/>
        <StyleInclude Source="avares://PLDUOBAO/UI/Effects/LineTextBlockStyles.axaml"/>
        <StyleInclude Source="avares://PLDUOBAO/UI/Effects/ProgressRingStyles.axaml"/>
    </Application.Styles>
    
    <Application.Resources>
        <ResourceDictionary>
            <!-- 背景色 -->
            <Color x:Key="BgPrimary">#FFFFFF</Color>
            <Color x:Key="BgSecondary">#F8F8F8</Color>
            <Color x:Key="BgTertiary">#F0F0F0</Color>
            
            <!-- 表面色 -->
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="SurfaceHover">#F5F5F5</Color>
            
            <!-- 边框 -->
            <Color x:Key="BorderLight">#E5E5E5</Color>
            <Color x:Key="BorderMedium">#D8D8D8</Color>
            
            <!-- 文字 -->
            <Color x:Key="TextPrimary">#1A1A1A</Color>
            <Color x:Key="TextSecondary">#5C5C5C</Color>
            <Color x:Key="TextMuted">#8C8C8C</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>